# Публичный адрес сайта (canonical, sitemap, Open Graph)
APP_BASE_URL=http://localhost:3000

# Neon Postgres — пока не используется (сайт работает на demo-данных)
# Pooled-строка для приложения, unpooled — для миграций Drizzle
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js. AUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (и такой же для production-домена).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Почты через запятую: при входе через Google они получают роль admin (доступ к /admin).
ADMIN_EMAILS=

# Только для E2E и локальной проверки: вход без Google через POST /api/test/login.
# Работает лишь при пустом DATABASE_URL (временная in-memory БД). В production не включать.
ENABLE_TEST_LOGIN=

# S3-совместимое хранилище для фото товаров
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Курс: сколько сумов за 1 доллар (например, 12650). Только для подписи «≈ $X» в оформлении,
# на странице Stripe и в админке; оплата всегда в сумах. Пусто — доллары не показываются.
USD_UZS_RATE=

# Stripe (тестовый режим): dashboard.stripe.com/test/apikeys → sk_test_… и pk_test_…
# Только на сервере, в Git не коммитить. Signing secret webhook (whsec_…) выдаёт
# `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe` или Dashboard → Webhooks.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
