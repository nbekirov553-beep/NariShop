# Публичный адрес сайта (canonical, sitemap, Open Graph)
APP_BASE_URL=http://localhost:3000

# Neon Postgres — пока не используется (сайт работает на demo-данных)
# Pooled-строка для приложения, unpooled — для миграций Drizzle
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth.js — понадобится для входа и админки
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-совместимое хранилище для фото товаров
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
